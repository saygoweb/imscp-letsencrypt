<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <!--
        Needs the panel bootstrapped (/var/www/imscp/gui/include/imscp-lib.php)
        and a database, like SGW_GraphQL's own integration/authz suites. It is
        skipped rather than failed off the box.
    -->
    <testsuites>
        <testsuite name="graphql">
            <directory>.</directory>
        </testsuite>
    </testsuites>
    <!--
        What a coverage run (the GraphQL job in .github/workflows/test.yml)
        measures: the plugin's own PHP source, not its tests or tooling.
    -->
    <coverage>
        <include>
            <directory suffix=".php">../../GraphQL</directory>
            <directory suffix=".php">../../frontend</directory>
            <file>../../SGW_LetsEncrypt.php</file>
        </include>
    </coverage>
</phpunit>
